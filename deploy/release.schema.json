{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stratus-2 immutable application release",
  "type": "object",
  "required": ["commit", "nextcloud", "worker", "protocol", "nextcloud_version", "job_schema", "billing_schema"],
  "properties": {
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "nextcloud": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
    "worker": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
    "protocol": {"const": 1},
    "nextcloud_version": {"const": "35.0.2.2"},
    "job_schema": {"const": 1},
    "billing_schema": {"const": 2}
  },
  "additionalProperties": false
}
